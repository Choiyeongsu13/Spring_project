<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mnu.sample.mapper.BoardMapper">
	<!-- 1. 전체 글 카운터 get -->
	<select id = "BoardCount" resultType="int">
		select count(*) from tbl_board
	</select>
	
	<!-- 2. 검색 조건에 해당하는 글수 post -->
<select id ="BoardCountSearch" resultType="string">
	select count(*) from tbl_board where 
	<choose> <!-- 스위치 케이스 -->
		<when test="search=='name'" >
		<!-- 동시에 get,post를 처리할경우 where 이 여기에 붙음 -->	name like '%' ||  #{key} || '%'
		</when>
		
		<when test="search=='subject'" >
			subject like '%' ||  #{key} || '%'
		</when>
		
		<when test="search=='contents'" >
			contents like '%' ||  #{key} || '%'
		</when>
		
	</choose>
</select>


