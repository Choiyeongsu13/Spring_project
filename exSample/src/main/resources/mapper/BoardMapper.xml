	<!-- 3. 전체 목록 get-->
<select id ="BoardList" resultType="com.mnu.sample.domain.BoardDTO">
		select * from tbl_board order by idx desc
</select>
	
	<!-- 4. 검색조건에 맞는 목록 post -->
<select id="BoardListSearch" resultType="com.mnu.sample.domain.BoardDTO">
		select * from tbl_board where 
		<choose>
			<when test ="search=='name'">
				name like '%' || #{key} || '%'
			</when>
			<when test ="search=='subject'">
				subject like '%' || #{key} || '%'
			</when>
			<when test ="search=='contents'">
				contents like '%' || #{key} || '%'
			</when>

		</choose>
		
		order by idx desc
</select>
	
	<!-- 5. 글 등록 -->
	
	<insert id="BoardWrite">
		insert into tbl_board (idx,name,subject,contents,pass) values(tbl_board_seq_idx.nextval, #{name},#{subject}
		, #{contents}, #{pass})
	</insert>
